{
  "name": "nimloth-legacy-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "description": "B4-bevisets legacy-motpart. Rekvisita, inte produkt. Se README.md för det hårda taket.",
  "scripts": {
